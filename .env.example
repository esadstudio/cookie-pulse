# Cookie Chain community RPC (documented name used by Cookie tooling).
COOKIE_RPC_URL=https://rpc.cookiescan.io

# Vite exposes only VITE_* vars to the browser. These are the values the app reads.
VITE_COOKIE_RPC_URL=https://rpc.cookiescan.io

# Optional. Official docs list https://wss.cookiescan.io; that host currently
# presents a mismatched TLS cert, so the app defaults to HTTP RPC polling.
# Set this only if you have a working Cookie WebSocket endpoint (wss://...).
# VITE_COOKIE_WSS_URL=wss://wss.cookiescan.io
